<?xml version="1.0" encoding="UTF-8"?>
<!--
  AutoniCK: inicializador da demonstração local (só 127.0.0.1, dados fictícios, não é para deploy). A classe principal
  AutonickLocal sobe um PostgreSQL 18 portátil e persistente, aplica as migrations e sobe a API Java (java/os-api), que
  entrega a PWA. O módulo também traz o instalador do banco da demonstração pública (InstalarBancoPublico) e a
  demonstração anterior, só das ordens de serviço (DemoPwaLocal).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>br.com.ckgroup.autonick</groupId>
  <artifactId>demo-pwa-local</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>AutoniCK inicializador local</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- PostgreSQL 18 portátil (binários oficiais da EDB reempacotados no Maven Central pelo projeto zonky, Apache 2.0).
         Só o pacote do sistema em uso é baixado (perfis abaixo). Sem instalação e sem serviço do Windows. -->
    <!-- Classe principal: AutonickLocal (demonstração completa). Outras: -Dautonick.main=...InstalarBancoPublico ou ...DemoPwaLocal. -->
    <autonick.main>br.com.ckgroup.autonick.demo.AutonickLocal</autonick.main>
    <embedded-postgres.version>2.2.2</embedded-postgres.version>
    <postgres-binarios.version>18.6.0</postgres-binarios.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.11</version>
    </dependency>
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <version>${embedded-postgres.version}</version>
      <exclusions>
        <exclusion>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>1.7.36</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.21.4</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>${autonick.main}</mainClass>
          <systemProperties>
            <systemProperty>
              <key>autonick.raiz</key>
              <value>${project.basedir}/../..</value>
            </systemProperty>
            <systemProperty>
              <key>org.slf4j.simpleLogger.defaultLogLevel</key>
              <value>warn</value>
            </systemProperty>
            <systemProperty>
              <key>autonick.demo.saida</key>
              <value>${project.build.directory}</value>
            </systemProperty>
          </systemProperties>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>postgres-windows</id>
      <activation><os><family>windows</family><arch>amd64</arch></os></activation>
      <dependencies>
        <dependency>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
          <version>${postgres-binarios.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>postgres-linux</id>
      <activation><os><name>Linux</name><arch>amd64</arch></os></activation>
      <dependencies>
        <dependency>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
          <version>${postgres-binarios.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>postgres-mac-arm</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <dependencies>
        <dependency>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
          <version>${postgres-binarios.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
